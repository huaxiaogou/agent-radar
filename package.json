{
  "name": "agent-radar",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run test:unit && npm run build && node --test tests/rendered-html.test.mjs",
    "test:unit": "node --test tests/radar-pipeline.test.mjs tests/deployment-scripts.test.mjs tests/graph-geometry.test.mjs",
    "ingest": "node --no-warnings scripts/ingest.mjs --trigger manual",
    "ai:check": "node --no-warnings scripts/check-ai.mjs",
    "radar:status": "node --no-warnings scripts/status.mjs",
    "lint": "eslint . --ignore-pattern .next"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.10.1",
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@babel/core@7": "7.29.7",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@5": "5.0.9",
    "js-yaml@4": "4.3.0",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "type": "module"
}
