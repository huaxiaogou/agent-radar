# 可选：auto 会优先兼容现有 OpenAI 配置；只配置 DeepSeek Key 时自动使用 DeepSeek。
# 可显式填写 auto、deepseek、openai 或 rules。
RADAR_AI_PROVIDER=auto

# DeepSeek（推荐用于本站的结构化摘要任务）。Key 只保存在服务器 .env.production。
DEEPSEEK_API_KEY=
RADAR_DEEPSEEK_MODEL=deepseek-v4-flash
RADAR_DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI（继续兼容已有部署）。
OPENAI_API_KEY=
RADAR_OPENAI_MODEL=gpt-5.6-terra

# 正式默认值通常无需修改。
RADAR_MAX_NEW_ITEMS=48
# 留空时 AI 默认覆盖本轮拟发布上限；需要控制成本时再设置更小的整数上限。
RADAR_MAX_AI_ITEMS=
RADAR_RELEVANCE_THRESHOLD=5
# 宽进严出：先保留少量边界候选，正文补全和 AI 分析后再执行发布阈值。
RADAR_DISCOVERY_RELEVANCE_THRESHOLD=3
RADAR_MAX_ITEM_AGE_DAYS=120
